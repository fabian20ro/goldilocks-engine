{
  "name": "goldilocks-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && vite build --base=/goldlocks-engine/",
    "build:pwa-update-fixtures": "node scripts/build-pwa-update-fixtures.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "PLAYWRIGHT_BROWSERS_PATH=.cache/ms-playwright playwright test",
    "test:e2e:pages": "PLAYWRIGHT_BROWSERS_PATH=.cache/ms-playwright playwright test --config=playwright.pages.config.ts",
    "balance": "tsx src/simulation/runNumericPrototype.ts && npm run balance:first-session && npm run balance:upgrades && npm run balance:progression && npm run balance:career && npm run balance:evaluation",
    "balance:first-session": "tsx src/simulation/runFirstSessionBalance.ts",
    "balance:upgrades": "tsx src/simulation/runUpgradeBalance.ts",
    "balance:progression": "tsx src/simulation/runProgressionBalance.ts",
    "balance:career": "tsx src/simulation/runCareerBalance.ts",
    "balance:evaluation": "tsx src/simulation/runEvaluationBalance.ts"
  },
  "dependencies": {
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "26.1.1",
    "@types/react": "19.0.3",
    "@types/react-dom": "19.0.2",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.1.0",
    "eslint-plugin-react-refresh": "0.4.16",
    "fast-check": "3.23.2",
    "globals": "15.14.0",
    "jsdom": "25.0.1",
    "prettier": "3.4.2",
    "tsx": "4.23.1",
    "typescript": "5.7.2",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  }
}
