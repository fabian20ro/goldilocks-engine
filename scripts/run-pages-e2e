#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$ROOT"

if [ ! -x node_modules/.bin/vite ]; then
  echo "Dependencies missing. Run ./scripts/setup first." >&2
  exit 1
fi

npm run build:pages
E2E_PORT=${E2E_PORT:-4173}
exec npm run preview -- --host 127.0.0.1 --port "$E2E_PORT" --strictPort --base=/goldlocks-engine/
